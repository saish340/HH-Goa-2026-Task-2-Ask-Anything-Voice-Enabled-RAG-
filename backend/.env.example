# Copy to `.env` and adjust. Loaded by the backend (export or dotenv).
# All vars are optional; the pipeline runs with defaults and is offline-capable.

# --- Voice STT (Sarvam AI) ---------------------------------------------------
# Leave unset to run the voice flow offline (transcribe returns a clear error).
SARVAM_API_KEY=

# --- Paths -------------------------------------------------------------------
# Where the corpus + index live (defaults to <repo>/data).
# AA_DATA_DIR=C:/absolute/path/to/data

# --- Compute -----------------------------------------------------------------
# AA_FORCE_CPU=1            # force CPU even if CUDA is present
# AA_DEVICE=cpu

# --- Models ------------------------------------------------------------------
# AA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# AA_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# AA_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# --- Retrieval ---------------------------------------------------------------
# AA_DENSE_TOP_K=20
# AA_BM25_TOP_K=20
# AA_FUSION_TOP_K=8
# AA_RERANK_TOP_K=10
# AA_RERANK_MAX_CHUNKS=20

# --- Guardrails --------------------------------------------------------------
# AA_OFF_TOPIC_COSINE=0.58
# AA_CONFIDENCE_MIN=0.25
# AA_GROUNDING_MIN=0.30
# AA_EXTRACT_MIN_SIM=0.50
# AA_EXTRACT_MIN_COVERAGE=0.15
# AA_EXTRACT_MIN_WORDS=3
# AA_RERANK_REFUSE_BELOW=1.5
# AA_RERANK_REFUSE_HARD=0.5
# AA_EXTRACT_STRONG=0.6